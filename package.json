{
  "name": "pi-claude-bridge",
  "version": "0.1.0",
  "description": "pi extension that makes pi sessions peers of Claude Code's cross-session messaging",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^24.0.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "author": "Beau Gunderson",
  "repository": {
    "type": "git",
    "url": "https://github.com/beaugunderson/pi-claude-bridge.git"
  },
  "homepage": "https://github.com/beaugunderson/pi-claude-bridge",
  "keywords": [
    "pi-package",
    "claude-code"
  ],
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.30.1",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
